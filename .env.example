# ────────────────────────────────────────────────────────────────────
# Supabase (Phase 2 — Auth + Phase 3 — Data)
# ────────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                                # anon public key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                                    # ⚠️ server-only, never NEXT_PUBLIC_

# ────────────────────────────────────────────────────────────────────
# Site URL — used to compute the OAuth redirect
# ────────────────────────────────────────────────────────────────────
# Locally defaults to http://localhost:3000 if unset; production:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────────
# Google OAuth credentials
# ────────────────────────────────────────────────────────────────────
# Per security rule (requirements2.docx §14): Client Secret NEVER
# reaches the frontend.  Configure it inside the Supabase dashboard
# (Authentication → Providers → Google), not here.  We only forward to
# Supabase; this app never talks to Google directly.

# ────────────────────────────────────────────────────────────────────
# OpenAI (already configured — leave as-is)
# ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
